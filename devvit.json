{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "street-soccer",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "tall",
        "inline": true
      },
      "game": {
        "entry": "index.html"
      }
    }
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "scope": "user",
      "asUser": ["SUBMIT_COMMENT", "SUBMIT_POST"]
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create Street Soccer match",
        "description": "Pick the match settings players get",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Delete my Street Soccer data",
        "description": "Remove your saved leaderboard results in this subreddit",
        "location": "subreddit",
        "endpoint": "/internal/menu/delete-data"
      }
    ]
  },
  "forms": {
    "challengeForm": "/internal/form/challenge-submit",
    "deleteDataForm": "/internal/form/delete-data"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostDelete": "/internal/triggers/on-post-delete"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "street_soccer_dev"
  },
  "scheduler": {
    "tasks": {
      "privacy-cleanup": {
        "endpoint": "/internal/scheduler/privacy-cleanup",
        "cron": "*/10 * * * *"
      }
    }
  }
}

{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "street-soccer",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "tall",
        "inline": true
      },
      "casual": {
        "entry": "casual.html"
      },
      "game": {
        "entry": "index.html"
      },
      "freekick-infinity": { "entry": "freekick-infinity.html" },
      "freekick-practice": {
        "entry": "freekick-practice.html"
      },
      "freekick-challenge": {
        "entry": "freekick-challenge.html"
      },
      "freekick-playground": {
        "entry": "freekick-playground.html"
      }
    }
  },
  "permissions": {
    "journeys": true,
    "redis": true,
    "reddit": {
      "enable": true,
      "scope": "user",
      "asUser": ["SUBMIT_COMMENT", "SUBMIT_POST", "SUBSCRIBE_TO_SUBREDDIT"]
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create Street Soccer match",
        "description": "Pick the match settings players get",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "View Street Soccer analytics",
        "description": "View the last seven days of aggregate play events for this post",
        "location": "post",
        "forUserType": "moderator",
        "postFilter": "currentApp",
        "endpoint": "/internal/menu/play-metrics"
      },
      {
        "label": "Delete my Street Soccer data",
        "description": "Remove your saved leaderboard results in this subreddit",
        "location": "subreddit",
        "endpoint": "/internal/menu/delete-data"
      }
    ]
  },
  "forms": {
    "freeKickModeForm": "/internal/form/freekick-mode",
    "dailyModeForm": "/internal/form/daily-mode",
    "matchTypeForm": "/internal/form/match-type",
    "challengeForm": "/internal/form/challenge-submit",
    "playMetricsForm": "/internal/form/play-metrics",
    "deleteDataForm": "/internal/form/delete-data"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostDelete": "/internal/triggers/on-post-delete"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "street_soccer_dev"
  },
  "scheduler": {
    "tasks": {
      "privacy-cleanup": {
        "endpoint": "/internal/scheduler/privacy-cleanup",
        "cron": "*/10 * * * *"
      }
    }
  }
}
